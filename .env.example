# ── Docker / インフラ ──
COMPOSE_PROJECT_NAME=karakuri-agent
# Docker Compose の user: に渡す数値 UID / GID
# Linux / macOS / WSL では `id -u` / `id -g` の出力結果をそのまま入れる
# Docker Desktop on Windows など所有者差分を気にしなくてよい環境では 1000 / 1000 でも可
UID=1000
GID=1000
BIND_ADDRESS=127.0.0.1
PORT=3000
# ローカル実行では `./data` のままでよい。
# Docker Compose では container 内の DATA_DIR を `/app/data` に固定し、ホスト側保存先は volume 側で合わせる。
DATA_DIR=./data
TIMEZONE=Asia/Tokyo

# ── Discord ──
DISCORD_BOT_TOKEN=your-discord-bot-token
DISCORD_PUBLIC_KEY=your-discord-public-key
DISCORD_APPLICATION_ID=your-discord-application-id
ALLOWED_CHANNEL_IDS=
REPORT_CHANNEL_ID=
ADMIN_USER_IDS=

# ── LLM ──
LLM_API_KEY=your-llm-api-key
LLM_BASE_URL=
LLM_MODEL=openai/gpt-4o
LLM_ENABLE_THINKING=true
# OpenAI 互換サーバー固有の enable_thinking=false を送る場合のみ true
LLM_DISABLE_THINKING_REQUEST_PARAM=false
MAX_STEPS=10
TOKEN_BUDGET=8000

# ── Webサーチ ──
BRAVE_API_KEY=

# ── からくりワールド ──
# 例: https://karakuri.example.com/api（/api なしの値は起動時に補完される）
KARAKURI_WORLD_API_BASE_URL=
KARAKURI_WORLD_API_KEY=
KARAKURI_WORLD_BOT_IDS=

# 自己を指す別名（エージェントの表示名など、カンマ区切り）。
# relations の主語/目的語の「自分」表記ゆらぎを 'self' へ正規化する（#106）
AGENT_SELF_NAMES=

# ── SNS ──
# Provider ごとに必要キーが揃ったものだけ同時有効化される
# Mastodon: MASTODON_INSTANCE_URL と MASTODON_ACCESS_TOKEN は両方必須
MASTODON_INSTANCE_URL=
MASTODON_ACCESS_TOKEN=
# X: X_ACCESS_TOKEN が必須。必要に応じて OAuth 2.0 refresh / OAuth 1.0a 情報も設定
X_ACCESS_TOKEN=
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REFRESH_TOKEN=
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN_SECRET=

# ELYTH: ELYTH_API_KEY と ELYTH_API_BASE は両方必須（例: https://elythworld.com）
ELYTH_API_KEY=
ELYTH_API_BASE=
# 旧 data/sns-activity.db がある場合のみ指定: mastodon|x|elyth|skip
SNS_LEGACY_DB_MIGRATE_TO=

# ── Bot 動作 ──
HEARTBEAT_INTERVAL_MINUTES=120
# M8: KW カスタムコマンド統合（KW コンソールで登録した command 名を指定。設定されたものだけ有効）
# KW_COMMAND_CHECK_PHONE=check_phone
# KW_COMMAND_BROWSE_SNS=browse_sns
# KW_COMMAND_POST_SNS=post_sns
# M9 #110: 能動メッセージ（催促・個別共有）。KW_COMMAND_CHECK_PHONE の設定が必須
# KW_COMMAND_SEND_MESSAGE=send_message

# M8: SNS 書き込みレート制限（共通既定。0 でそのアクションを禁止）
# SNS_RATE_LIMIT_POST_PER_HOUR=3
# SNS_RATE_LIMIT_POST_PER_DAY=20
# SNS_RATE_LIMIT_POST_MIN_INTERVAL_MINUTES=15
# SNS_RATE_LIMIT_REPLY_PER_HOUR=10
# SNS_RATE_LIMIT_LIKE_PER_HOUR=30
# SNS_RATE_LIMIT_REPOST_PER_HOUR=10
# provider 別上書き（X_ / MASTODON_ / ELYTH_ プレフィックス）
# X_RATE_LIMIT_POST_PER_DAY=10
# M8: SNS 読み取りフェッチの最小間隔（分。間隔内はキャッシュ返却）
# SNS_FETCH_MIN_INTERVAL_NOTIFICATIONS_MINUTES=10
# SNS_FETCH_MIN_INTERVAL_TIMELINE_MINUTES=30
# SNS_FETCH_MIN_INTERVAL_TRENDS_MINUTES=60

# ── 生きたエージェント（living-agent）段階導入フラグ ──
# KW の行動選択用通知をセッション履歴に積まず Perception Buffer で扱う（既定 true）
KW_PERCEPTION_BUFFER_ENABLED=true
# 同一行動×同一対象の反復に対する trusted 警告注入（既定 true）
LOOP_WARNING_ENABLED=true
# 警告を発火する連続回数の閾値（既定 3）
LOOP_DETECTOR_THRESHOLD=3
# LLMプロバイダの「同一tool-callの連続」検知エラー時に、セッション履歴から重複 tool-call/tool-result
# ペアを除去して1回だけリトライする機能の有効化（既定 true）
REPETITIVE_TOOL_CALL_RECOVERY_ENABLED=true
# 統合 appraisal（内部状態更新）の有効化（既定 true）
APPRAISAL_ENABLED=true
# appraisal LLM 呼び出しのタイムアウト（ms。既定 30000。バックエンドが遅い場合に延長）
# APPRAISAL_TIMEOUT_MS=90000
# ペルソナ依存の解釈パターン（正規表現、i フラグで評価。設定時は proc_version に反映される）
# どの行動 ID（KW の action_id）が「眠りに入る行為」か。既定: sleep|nap|就寝|寝る
# ロボットペルソナなら充電を眠りとして扱う例:
# KW_SLEEP_ACTION_PATTERN=sleep|nap|就寝|寝る|charge|充電
# どの文脈を「空腹回復（エネルギー補給）」と認めるか。既定は人間の食事語彙 + 機械の補給語彙の混在。
# ロボットペルソナで補給語彙のみに絞る例:
# APPRAISAL_FOOD_CONTEXT_PATTERN=充電|チャージ|給電|エネルギー補給|燃料|給油|charge|recharge|refuel|charging
# 内部状態の自然言語注入の有効化（既定 true）
INNER_STATE_INJECTION_ENABLED=true
# appraisal 役割のモデル指定（未指定は LLM_MODEL へフォールバック。軽量モデル推奨）
LLM_APPRAISAL_MODEL=
LLM_APPRAISAL_API_KEY=
LLM_APPRAISAL_BASE_URL=
# appraisal の出力取得モード（既定 json_schema）。
# json_schema: response_format による構造保証（OpenAI 本家等スキーマ強制が効くバックエンド向け）
# tool: 強制 tool call ×2 の分割スキーマ（response_format(json_schema) を黙って無視する
#       バックエンド — Featherless 等 — 向け。tool call 対応モデルが前提）
# LLM_APPRAISAL_OUTPUT_MODE=tool
# 自動想起（エピソード記憶）のプロンプト注入の有効化（既定 true）
RECALL_INJECTION_ENABLED=true
# 埋め込みモデル（OpenAI 互換。未設定なら FTS のみで想起）
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_DIMENSIONS=1536
# 省察エンジン（日次/週次/月次）の有効化（既定 true）
REFLECTION_ENABLED=true
# 自己像（経験で変化する人格）の自己語り注入（既定 true）
SELF_IMAGE_INJECTION_ENABLED=true
# 省察役割のモデル指定（未指定は LLM_MODEL。長く残るものを書くため強いモデル推奨）
LLM_REFLECTION_MODEL=
LLM_REFLECTION_API_KEY=
LLM_REFLECTION_BASE_URL=
# 省察の出力取得モード（既定 json_schema。appraisal と同じ切替 — 詳細は LLM_APPRAISAL_OUTPUT_MODE 参照）
# LLM_REFLECTION_OUTPUT_MODE=tool
# 省察 LLM 呼び出しの 1 コールタイムアウト（ms。既定 180000）
# REFLECTION_TIMEOUT_MS=180000
# 欲求・飽き圧の注入（既定 true）
DRIVES_INJECTION_ENABLED=true
# 展望記憶（約束・予定・目標）の注入（既定 true）
PROSPECTS_INJECTION_ENABLED=true
